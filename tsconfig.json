{
  // Type-checks the TypeScript in shared/: the chrome every demo mounts and the
  // download kit it wraps. The demos themselves are plain JS, linted by eslint.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"]
  },
  "include": ["shared/chrome", "shared/downloadKit", "vitest.config.ts"]
}
