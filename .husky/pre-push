export PATH="/opt/homebrew/bin:$PATH"

# ── Lock file sync check (always before push; root and every app) ──────────
for dir in . $(node scripts/apps.mjs list); do
  (cd "$dir" && npm install --package-lock-only --ignore-scripts 2>/dev/null)
  if ! git diff --quiet -- "$dir/package-lock.json"; then
    echo ""
    echo "❌ $dir/package-lock.json is out of sync with its package.json."
    echo "   Run 'npm install' in $dir and commit the updated lock file before pushing."
    echo ""
    exit 1
  fi
done

# ── Block new hollow stubs / @ts-nocheck test files ────────────────────────
node scripts/check-test-quality.mjs

# ── shared/ suite, then every app's suite — each with a 100% coverage floor ─
npm run test
npm run lint
