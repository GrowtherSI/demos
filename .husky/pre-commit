export PATH="/opt/homebrew/bin:$PATH"

# ── Lock file sync check (only for packages whose package.json is staged) ───
# The root and every app keep their own lockfile (see scripts/apps.mjs).
staged=$(git diff --cached --name-only)
for dir in . $(node scripts/apps.mjs list); do
  pkg="$dir/package.json"; [ "$dir" = "." ] && pkg="package.json"
  if printf '%s\n' "$staged" | grep -qxF "$pkg"; then
    (cd "$dir" && npm install --package-lock-only --ignore-scripts 2>/dev/null)
    if ! git diff --quiet -- "$dir/package-lock.json"; then
      echo ""
      echo "❌ $dir/package-lock.json is out of sync with $pkg."
      echo "   The lock file has been updated — please stage it:"
      echo "     git add $dir/package-lock.json"
      echo ""
      exit 1
    fi
  fi
done

npx lint-staged
npm run lint
