{
  "name": "@growther-demos/repo",
  "version": "1.0.0",
  "private": true,
  "description": "Repository-wide tooling for the Growther.si OpenSource demos: lint, format, hooks, and the shared/ test suite.",
  "license": "MIT",
  "author": "Growther.si",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GrowtherSI/demos.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0 && tsc --noEmit && npm run check:download-kit",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:shared && npm run test:apps",
    "test:shared": "vitest run --coverage",
    "test:apps": "node scripts/apps.mjs run test",
    "apps:install": "node scripts/apps.mjs ci",
    "check:download-kit": "node scripts/check-download-kit.mjs",
    "check:test-quality": "node scripts/check-test-quality.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,jsx}": [
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
